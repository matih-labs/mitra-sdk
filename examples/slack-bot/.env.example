# Slack (from https://api.slack.com/apps: create the app from manifest.yml)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Matih: one workspace integration key (Settings › API & MCP). Never commit the real value.
MATIH_API_KEY=mtk_your_key_here

# Optional
# MATIH_ACCESS_TOKEN=mto_...      # use instead of MATIH_API_KEY to allow switching workspaces
# MATIH_BASE_URL=https://workspace.matih.ai   # the host only; /api/v1 is added for you
# MATIH_BOT_DB=matih_bot.sqlite3

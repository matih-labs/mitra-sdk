{
  "name": "@matihlabs/embed",
  "version": "0.1.1",
  "description": "The <matih-embed> web component: a Matih dashboard, Gems feed or Ask box in an iframe, with the signed token kept out of the URL query and refreshed from your backend.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matih-labs/mitra-sdk.git",
    "directory": "sdks/embed"
  },
  "homepage": "https://github.com/matih-labs/mitra-sdk/tree/main/sdks/embed",
  "bugs": {
    "url": "https://github.com/matih-labs/mitra-sdk/issues"
  },
  "keywords": ["matih", "mitra", "embed", "web-component", "iframe", "dashboard"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build && npm run size"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
